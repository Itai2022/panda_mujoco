<mujoco model="panda scene">
  <compiler meshdir="./franka_emika_panda/assets/" texturedir="./furniture_sim/assets/"/>
  <include file="./franka_emika_panda/panda_z_off_set.xml"/>
  <include file="./furniture_sim/simpleTable/simpleTable_asset.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- <site name="start_circle" size="0.1 0.005" type="cylinder" pos="0.7 -0.3 0.425" rgba=".6 .3 .2 0.5" /> -->
    <site name="target_circle" size="0.1 0.005" type="cylinder" pos="0.5 0.3 0.425" rgba=".3 .6 .2 0.5" />
    <body name="obs" pos="0.5 -0.1 0.5">
      <geom name="bos" type="box" size="0.3 0.03 0.08" rgba="0.25 0.25 0.25 1.0" contype="1" conaffinity="1" mass="0.05" condim="4" friction="1.0 0.05 0.001"/>
    </body>
    <body name="blue_block"  pos="0.7 -0.3 0.445">
      <freejoint/>
      <geom name="blue_block" type="box" size="0.02 0.02 0.02" rgba="0.2 0.2 0.6 1.0" contype="1" conaffinity="1" mass="0.05" condim="4" friction="1.0 0.05 0.001"/>
    </body>
    <body name="red_block"  pos="0.4 -0.4 0.475">
      <freejoint/>
      <geom name="red_block" type="box" size="0.025 0.025 0.05" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1" mass="0.05" condim="4" friction="1.0 0.05 0.001"/>
    </body>
    <body pos="1.0 0 1.0" xyaxes="0 1 0 -1.3 0 1" >
      <!-- <camera name="eye_to_hand" mode="targetbody" target="simpleMarbleTable" fovy="60" /> -->
      <camera name="eye_to_hand" fovy="60" />
    </body>
    <body pos="0 0 0.15">
      <geom type="box" size="0.2 0.15 0.15" rgba=".1 .1 .1 1"/>
    </body>
    <body pos="0.5 0 0" euler="0 0 1.57079">
      <include file="./furniture_sim/simpleTable/simpleMarbleTable_body.xml"/>
    </body>
  </worldbody>
</mujoco>
